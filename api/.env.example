# Copy these values into the server environment. Do not commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sree_manju_pharmacy
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
API_TOKEN_SECRET=GENERATE_A_LONG_RANDOM_SECRET
TOKEN_TTL=28800
APP_URL=https://your-pharmacy-domain.example

# Optional: SMS/WhatsApp receipts via Twilio. Leave blank to disable -
# sales complete normally either way, receipts are best-effort only.
# TWILIO_SMS_FROM is a Twilio phone number in E.164 format (e.g. +15551234567).
# TWILIO_WHATSAPP_FROM is only needed if you also want WhatsApp receipts and
# have a WhatsApp-enabled Twilio number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
